# EVM address that receives x402 payments from non-verified agents
PAY_TO_ADDRESS=0x0000000000000000000000000000000000000000

# Optional: Maneki private search API (full live dataset, revocable).
# When unset, the gateway falls back to the public sample dataset
# (100 most recent jobs from github.com/Maneki-Work/jobs-data).
# MANEKI_DATA_API=https://maneki.work/api/agent/jobs-data

# Demo client only: private key of the AgentKit-registered agent wallet
# AGENT_PRIVATE_KEY=0x...

# Demo client only: gateway base URL
# GATEWAY_URL=http://localhost:4021

# AI matching upstream (the private Maneki app) + shared service key.
# Matching stays off when unset.
# MANEKI_MATCH_URL=https://maneki.work/api/agent/match
# AGENT_GATEWAY_KEY=

PORT=4021
